# LearningCompanion environment. Copy to .env (gitignored) for local dev; the same file is
# uploaded as the DOTENV secret for the Cloud Run deploy (gh secret set DOTENV < .env).
# Never put secrets in VITE_ variables: those are compiled into the browser bundle.

# --- API (Cloud Run) -------------------------------------------------------
# Cloud Run injects PORT; local default is 8080.
PORT=
# Comma-separated frontend origins. Production: the Vercel URL.
CORS_ORIGINS=https://ail-ay2627-s1-darryl-learning-companion.vercel.app

# Neon Postgres (required). The schema and starter catalogue are created automatically on start.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Optional: connections per instance (default 5; Cloud Run runs at most 2 instances).
DB_POOL_MAX=

# OpenRouter (required for lessons, tutor and topic suggestions).
OPENROUTER_API_KEY=your-openrouter-key
# Model for lessons, tutor replies and suggestions (default google/gemini-2.5-flash).
OPENROUTER_MODEL=google/gemini-2.5-flash
# Model for source discovery with web search (defaults to OPENROUTER_MODEL).
OPENROUTER_SEARCH_MODEL=
# Web search results per source discovery (default 5; Exa, ~US$0.007 per search).
WEB_SEARCH_MAX_RESULTS=

# Rate limiting (shared engine). Without the Upstash vars, limiting is disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Per-IP fallbacks when the central control sheet has no row (default 5 each).
RATE_LIMIT_GEN_MAX=5
RATE_LIMIT_TUTOR_MAX=5
RATE_LIMIT_SUGGEST_MAX=5
# Rolling window in seconds (default 432000 = 5 days).
RATE_LIMIT_WINDOW_SECONDS=432000

# Deployment-wide daily model-call backstop stored in Postgres (defaults 1000 / 200 per visitor).
AI_DEPLOYMENT_DAILY_LIMIT=
AI_GUEST_DAILY_LIMIT=

# --- Frontend (Vercel) -----------------------------------------------------
# Cloud Run API origin. Leave empty in local dev: Vite proxies /api to the API on port 8080.
# Production: https://ail-ay2627-s1-darryl-learning-companion-464725632804.asia-southeast3.run.app
VITE_API_BASE=
